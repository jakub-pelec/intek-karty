# Auth.js
# Staging/prod: AUTH_URL must be the public https origin (no trailing slash)
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_SESSION_MAX_AGE=2592000

# Twitch OAuth + EventSub
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EVENTSUB_SECRET=generate-a-random-secret-between-10-and-100-chars
# Comma-separated Twitch user IDs that receive the admin role on login
ADMIN_TWITCH_IDS=

# Postgres (Supabase)
# App: use the pooled URI (port 6543) with ?sslmode=require
DATABASE_URL=postgresql://postgres.xxxx:password@host:6543/postgres?sslmode=require

# Supabase (storage + realtime)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# New dashboard keys (preferred)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy names still work if you have anon / service_role instead
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Public bucket for card artwork (create in Supabase Storage, set public)
SUPABASE_CARD_BUCKET=card-art

# Strapi catalog CMS (editor). Staging/prod: public https origin of the CMS host.
STRAPI_URL=http://localhost:1337
STRAPI_TOKEN=
# Shared secret for POST /api/cms/sync (Strapi webhook header x-cms-sync-secret)
CMS_SYNC_SECRET=
