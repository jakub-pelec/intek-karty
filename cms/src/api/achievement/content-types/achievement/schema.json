{
  "kind": "collectionType",
  "collectionName": "achievements",
  "info": {
    "singularName": "achievement",
    "pluralName": "achievements",
    "displayName": "Achievement"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "conditionType": {
      "type": "enumeration",
      "enum": [
        "first_booster",
        "first_epic",
        "first_legendary",
        "first_joker",
        "cards_collected_threshold",
        "full_collection"
      ],
      "required": true
    },
    "threshold": {
      "type": "integer"
    },
    "pointReward": {
      "type": "integer",
      "default": 0,
      "required": true,
      "min": 0
    },
    "active": {
      "type": "boolean",
      "default": true,
      "required": true
    }
  }
}
